# VITE_ML_API_URL: Base URL of the separately hosted Python FastAPI ML service.
# For Vercel production: set to the live URL of your deployed ML service (e.g., https://resume-ml-api.onrender.com)
# For local development: leave empty (to use Vite's dev proxy) or set to http://localhost:5001
VITE_ML_API_URL=""

# GEMINI_API_KEY: Required for Gemini AI Career Assistant & Section Rewriter.
# Set this in your Python FastAPI service environment (e.g., in Render, Railway, or Cloud Run dashboard).
# Never exposed to the frontend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
